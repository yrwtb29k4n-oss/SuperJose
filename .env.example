# ---- Mercado Pago ----
# Access Token da conta do Mercado Pago do mercado
# Use TEST-... para sandbox, e APP_USR-... quando for pra producao
MP_ACCESS_TOKEN=TEST-COLOQUE-SEU-TOKEN-AQUI

# Chave Pix (e-mail) do Mercado Pago do mercado
MP_CHAVE_PIX=email-do-mercado@exemplo.com

# URL publica do seu backend, para o Mercado Pago conseguir chamar o webhook
# Em teste local, use ngrok/cloudflare tunnel: ex https://abc123.ngrok.app
NOTIFICATION_URL=https://SEU-DOMINIO-OU-TUNNEL/webhook/mercadopago

# ---- Supabase ----
# Encontrados em Project Settings > API (ou botao Connect) no painel do Supabase
# Use a chave "secret" (sb_secret_...), NUNCA a "publishable"
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_COLE-AQUI

# ---- Auth dos caixas ----
# Segredo usado para assinar os tokens de login de cada caixa
JWT_SECRET=troque-por-uma-string-aleatoria-grande

# Porta em que o servidor vai rodar
PORT=3000
